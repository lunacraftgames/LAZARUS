{
  "name": "lazarus-desktop",
  "productName": "LAZARUS",
  "version": "1.0.0",
  "description": "LAZARUS desktop build (Electron + Steamworks)",
  "main": "main.js",
  "private": true,
  "license": "GPL-3.0-or-later",
  "lazarus": {
    "steamAppId": 480
  },
  "scripts": {
    "start": "electron .",
    "debug": "electron . --debug",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lunacraftgames.lazarus",
    "productName": "LAZARUS",
    "executableName": "LAZARUS",
    "directories": { "output": "dist" },
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      { "from": "..", "to": "game", "filter": ["index.html", "js/**/*"] }
    ],
    "asarUnpack": ["node_modules/steamworks.js/**"],
    "win": { "target": "dir" },
    "linux": { "target": "dir" }
  }
}
